# ============================================================================
# AURA ARENA — environment template
# ============================================================================
# Copy to .env.local and fill in real values there. .env.local is gitignored;
# this file is not, so it must contain PLACEHOLDERS ONLY — never a live secret.
# ============================================================================

# -- Public deployment origin ------------------------------------------------
# Canonical browser-visible production URL. Vercel preview deployments can set
# NEXT_PUBLIC_VERCEL_URL automatically, but production should keep this value.
NEXT_PUBLIC_SITE_URL=https://auraarenaokx.vercel.app
# Optional Vercel-provided host, for previews only (example: branch-app.vercel.app).
NEXT_PUBLIC_VERCEL_URL=

# -- Supabase ----------------------------------------------------------------
# The publishable key is browser-safe. The secret key is server-only and must
# never be given a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://<supabase-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# -- LLM decisions (REQUIRED for agent analysis and battles) -----------------
# Every agent analysis and battle decision is made by this model: it returns the
# direction, confidence and reasoning itself. Without a key those requests fail
# with an explicit AI_UNAVAILABLE state — there is no deterministic fallback
# thesis, because a fabricated decision is worse than a visible outage.
OPENROUTER_API_KEY=sk-or-v1-replace_me
OPENROUTER_MODEL=anthropic/claude-3-haiku

# -- X Layer chain: wallet + on-chain proof ----------------------------------
# Blockchain/network configuration. Unrelated to exchange market data below.
# Server-only finalization settings. Deploy AuraArena.sol from the deployer
# account, then set its address here. Never expose or commit the private key.
X_LAYER_RPC_URL=https://testrpc.xlayer.tech/terigon
X_LAYER_CHAIN_ID=1952
X_LAYER_CONTRACT_ADDRESS=
X_LAYER_DEPLOYER_PRIVATE_KEY=

# -- AURA -> USDT Testnet redemption treasury (SERVER ONLY) ------------------
# Required only to enable demo AURA redemption. Never use NEXT_PUBLIC_* here.
X_LAYER_USDT_CONTRACT_ADDRESS=
X_LAYER_TREASURY_PRIVATE_KEY=

# Public values used only to build explorer links in the browser. The private
# deployer key above must never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_X_LAYER_EXPLORER=https://www.okx.com/web3/explorer/xlayer-test
NEXT_PUBLIC_X_LAYER_CONTRACT_ADDRESS=
NEXT_PUBLIC_X_LAYER_CHAIN_ID=1952

# -- OKX Exchange market data (PUBLIC — no credentials needed) ---------------
# Source of every price, 24h change, volume and candle in the Markets page:
#   GET /api/v5/public/instruments?instType=SPOT
#   GET /api/v5/market/tickers?instType=SPOT
#   GET /api/v5/market/ticker?instId=BTC-USDT
#   GET /api/v5/market/candles?instId=BTC-USDT
# These endpoints require NO api key, secret or passphrase. Only override the
# base URL if you need a regional domain.
OKX_API_BASE_URL=https://www.okx.com

# -- OKX Web3 / X Layer ON-CHAIN token data (AUTHENTICATED) ------------------
# A DIFFERENT system from the exchange API above. Powers the "X Layer tokens"
# tab via GET /api/v5/xlayer/token/token-list.
#
# These are SECRETS: server-only, never NEXT_PUBLIC_*, never in client code.
# Create them in the OKX developer portal. Leave them blank to run without the
# X Layer tab — it then shows a configuration notice instead of any fake token.
OKX_WEB3_API_BASE_URL=https://web3.okx.com
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Project id, used by OKX Web3 / OnchainOS products. Sent as OK-ACCESS-PROJECT
# when set.
OKX_PROJECT_ID=

# -- News (free, no credential required) -------------------------------------
# News comes from public RSS/Atom feeds. There is NO API key and NO paid
# subscription: the defaults are the outlets' own published feeds, currently
# CoinDesk and Cointelegraph (see src/lib/news/rss.ts).
#
# Leave NEWS_RSS_FEEDS unset to use those defaults. Set it to a comma-separated
# list of feed URLs to add or replace sources. If every feed fails, analysis
# continues with news explicitly marked unavailable to the model — no article is
# ever invented to fill the gap.
NEWS_RSS_FEEDS=
#
# LEGACY, unused. This pointed at a credentialed provider that was never
# implemented; nothing reads it for fetching any more. Superseded by
# NEWS_RSS_FEEDS above. Safe to delete.
NEWS_API_BASE_URL=
